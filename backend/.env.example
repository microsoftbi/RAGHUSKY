# --- Storage ---
DATABASE_URL=sqlite:///./ragusky.db
CHROMA_PATH=./chroma_data

# --- Embeddings (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text:latest

# --- LLM (OpenAI-compatible: OpenAI / DeepSeek / Qwen / Moonshot ...) ---
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# --- Auth ---
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_TTL_MIN=720
INITIAL_ADMIN_PASSWORD=changeme

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Ingest defaults (only used if ingest_config table is empty) ---
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120
DEFAULT_SPLITTER=recursive

# --- Paths ---
DOCUMENTS_DIR=../Documents
